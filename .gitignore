# ═══════════════════════════════════════════════════
# СЕКРЕТЫ
# ═══════════════════════════════════════════════════
# Реальные креды БД. В репо идёт только config.php (шаблон).
/app/config.local.php
.env
.env.*

# ═══════════════════════════════════════════════════
# БАЗА ДАННЫХ — главный секрет, токен живёт тут
# ═══════════════════════════════════════════════════
/app/storage/*.sqlite
/app/storage/*.sqlite3
/app/storage/*.db
/app/storage/*.db-journal
/app/storage/*.db-wal
/app/storage/*.db-shm
*.sql
*.sql.gz

# ═══════════════════════════════════════════════════
# RUNTIME (логи, сессии, rate-limit, кеш)
# ═══════════════════════════════════════════════════
/app/storage/*
!/app/storage/.gitkeep
/app/logs/*
!/app/logs/.gitkeep

# ═══════════════════════════════════════════════════
# ОС / РЕДАКТОР
# ═══════════════════════════════════════════════════
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.helix/
# nvim пишет эти файлы редко, но пусть будут
.nvim/
*.nvim-swp
# если ты не згал, то он их в пишет в /tmp директории, да и я их отключил, но ладно, пусть будет.

# ═══════════════════════════════════════════════════
# МУСОР (на всякий случай — если кто-то клонирует)
# ═══════════════════════════════════════════════════
node_modules/
vendor/
*.log
/tmp/
/tests/fixtures/*.local.*
